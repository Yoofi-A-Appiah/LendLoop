# Next.js (.env.local). `npx convex dev` writes the CONVEX_* lines for you.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex deployment env (set with `npx convex env set NAME value`, NOT in this file):
# CLERK_JWT_ISSUER_DOMAIN   https://<your-app>.clerk.accounts.dev
# N8N_REQUEST_WEBHOOK_URL   https://<n8n-host>/webhook/lendloop-request
# LENDLOOP_TO_N8N_SECRET    openssl rand -hex 32   (Convex signs, n8n verifies)
# N8N_TO_LENDLOOP_SECRET    openssl rand -hex 32   (n8n signs, Convex verifies)
