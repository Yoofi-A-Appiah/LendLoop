{
  "name": "LendLoop – Overdue reminders",
  "nodes": [
    {
      "id": "lendloop-overdue-reminders-0",
      "name": "Every day 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "lendloop-overdue-reminders-1",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        480
      ],
      "parameters": {}
    },
    {
      "id": "lendloop-overdue-reminders-2",
      "name": "Sign fetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst sign = (body) => {\n  const secret = $env.N8N_TO_LENDLOOP_SECRET;\n  if (!secret) throw new Error('N8N_TO_LENDLOOP_SECRET is not set');\n  const t = Math.floor(Date.now() / 1000);\n  return `t=${t},v1=${crypto.createHmac('sha256', secret).update(`${t}.${body}`).digest('hex')}`;\n};\nconst body = '{}';\nreturn [{ json: { body, signature: sign(body) } }];"
      }
    },
    {
      "id": "lendloop-overdue-reminders-3",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "lendloop-overdue-reminders-4",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      }
    },
    {
      "id": "lendloop-overdue-reminders-5",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Swap for Email/Slack (with n8n credentials). A failed send is reported as status \"failed\",\n// not thrown, so one bad address doesn't stop reminders to everyone else.\nconst l = $json;\nlet status = 'sent', detail;\ntry {\n  if (!l.borrower.email) throw new Error('borrower has no email');\n  console.log(`[LendLoop] to <${l.borrower.email}>: Hi ${l.borrower.name}, the ${l.toolName} was due back ${l.endDate} (${l.daysOverdue} day(s) ago).`);\n  detail = `Overdue reminder sent (${l.daysOverdue}d late)`;\n} catch (e) {\n  status = 'failed';\n  detail = `Reminder failed: ${e.message}`;\n}\nreturn { json: { loanId: l.loanId, idempotencyKey: l.idempotencyKey, status, detail } };"
      }
    },
    {
      "id": "lendloop-overdue-reminders-6",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst sign = (body) => {\n  const secret = $env.N8N_TO_LENDLOOP_SECRET;\n  if (!secret) throw new Error('N8N_TO_LENDLOOP_SECRET is not set');\n  const t = Math.floor(Date.now() / 1000);\n  return `t=${t},v1=${crypto.createHmac('sha256', secret).update(`${t}.${body}`).digest('hex')}`;\n};\nconst body = JSON.stringify($json);\nreturn { json: { body, signature: sign(body) } };"
      }
    },
    {
      "id": "lendloop-overdue-reminders-7",
      "name": "Write reminder status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/reminder-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      }
    }
  ],
  "connections": {
    "Run now": {
      "main": [
        [
          {
            "node": "Sign fetch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every day 09:00": {
      "main": [
        [
          {
            "node": "Sign fetch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign fetch": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock)": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Write reminder status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}